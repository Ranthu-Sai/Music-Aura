<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">yt.omada.cafe</domain>
        <domain includeSubdomains="true">y.com.sb</domain>
        <domain includeSubdomains="true">inv.perditum.com</domain>
        <domain includeSubdomains="true">googlevideo.com</domain>
    </domain-config>
</network-security-config>
